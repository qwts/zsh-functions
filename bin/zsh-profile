#!/usr/bin/env bash
# zsh-profile — managed-block editing for zsh startup files.
#
# One implementation of the "# BEGIN <name> / # END <name>" convention shared
# by managed-machine, local-bin, and agent-bot-identity. Callable from bash
# and node; the contract is byte-stable so any writer can own a block.
#
# Semantics:
#   - an existing block is rewritten in place (position stable, no growth)
#   - a new block is appended after stripping the file's trailing blank lines
#   - writes are atomic (same-dir temp + mv); lines outside markers are never
#     touched unless --absorb-marker or compact asks for it
set -euo pipefail

PROG=zsh-profile

usage() {
    cat <<'EOF'
usage: zsh-profile <command> [options]

  ensure-block       --file F --name NAME [--absorb-marker SUBSTR]...
                     block body is read from stdin
  remove-block       --file F --name NAME
  ensure-line        --file F --marker SUBSTR --line LINE
  ensure-path-block  --file F --name NAME --dir DIR [--append]
  lint               FILE...
  compact            FILE...

Blocks are delimited by exact "# BEGIN <name>" / "# END <name>" lines.
ensure-block replaces an existing block in place, or appends a new one with a
single blank separator; repeated runs never grow whitespace. --absorb-marker
deletes loose lines matching SUBSTR that sit outside any managed block.
EOF
}

die() {
    printf '%s: %s\n' "$PROG" "$1" >&2
    exit 1
}

# Octal mode of a file, BSD or GNU stat.
zp_mode() {
    stat -f %Lp "$1" 2>/dev/null || stat -c %a "$1" 2>/dev/null || echo 644
}

# Output temporary beside the destination: mv across filesystems is a
# copy+unlink, not an atomic rename, so the file being committed must be
# created in the destination's own directory.
zp_out_tmp() {
    mktemp "$(dirname "$1")/.zsh-profile.XXXXXX"
}

# Move tmp over dest only when content differs. Returns 0 on write, 1 on no-op.
zp_commit() {
    local dest="$1" tmp="$2"
    if [[ -f "$dest" ]] && cmp -s "$tmp" "$dest"; then
        rm -f "$tmp"
        return 1
    fi
    if [[ -f "$dest" ]]; then
        chmod "$(zp_mode "$dest")" "$tmp" 2>/dev/null || true
    fi
    mv -f "$tmp" "$dest"
    return 0
}

zp_require_file() {
    [[ -n "$1" ]] || die "missing --file"
    mkdir -p "$(dirname "$1")"
    [[ -f "$1" ]] || : >"$1"
}

zp_require_name() {
    [[ -n "$1" ]] || die "missing --name"
    [[ "$1" != *$'\n'* ]] || die "block name cannot contain a newline"
}

zp_ensure_block() {
    local file="$1" name="$2" absorb_file="$3" body_tmp="$4" out_tmp="$5"
    awk \
        -v begin="# BEGIN $name" \
        -v end="# END $name" \
        -v bodyfile="$body_tmp" \
        -v absorbfile="$absorb_file" '
        BEGIN {
            nbody = 0
            while ((getline l < bodyfile) > 0) body[nbody++] = l
            nabsorb = 0
            if (absorbfile != "") {
                while ((getline l < absorbfile) > 0) absorb[nabsorb++] = l
            }
            in_target = 0; in_other = ""; found = 0; emitted = 0; n = 0
        }
        {
            if (in_target) {
                if ($0 == end) {
                    if (!emitted) {
                        out[n++] = begin
                        for (i = 0; i < nbody; i++) out[n++] = body[i]
                        out[n++] = end
                        emitted = 1
                    }
                    in_target = 0
                }
                next
            }
            if (in_other != "") {
                out[n++] = $0
                if ($0 == in_other) in_other = ""
                next
            }
            if ($0 == begin) { in_target = 1; found = 1; next }
            if ($0 ~ /^# BEGIN /) { in_other = "# END " substr($0, 9); out[n++] = $0; next }
            absorbed = 0
            for (i = 0; i < nabsorb; i++) {
                if (absorb[i] != "" && index($0, absorb[i]) > 0) { absorbed = 1; break }
            }
            if (absorbed) next
            out[n++] = $0
        }
        END {
            if (in_target) exit 3
            if (!found) {
                while (n > 0 && out[n-1] ~ /^[ \t]*$/) n--
                if (n > 0) out[n++] = ""
                out[n++] = begin
                for (i = 0; i < nbody; i++) out[n++] = body[i]
                out[n++] = end
            }
            for (i = 0; i < n; i++) print out[i]
        }
    ' "$file" >"$out_tmp" || {
        [[ $? -eq 3 ]] && die "unterminated block \"# BEGIN $name\" in $file"
        die "failed to edit $file"
    }
}

zp_remove_block() {
    local file="$1" name="$2" out_tmp="$3"
    awk \
        -v begin="# BEGIN $name" \
        -v end="# END $name" '
        BEGIN { in_target = 0; in_other = ""; found = 0; removed_at = -1; n = 0 }
        {
            if (in_target) {
                if ($0 == end) in_target = 0
                next
            }
            if (in_other != "") {
                out[n++] = $0
                if ($0 == in_other) in_other = ""
                next
            }
            if ($0 == begin) { in_target = 1; found = 1; if (removed_at < 0) removed_at = n; next }
            if ($0 ~ /^# BEGIN /) { in_other = "# END " substr($0, 9); out[n++] = $0; next }
            out[n++] = $0
        }
        END {
            if (in_target) exit 3
            # Only whitespace adjacent to the removed block may change; edge
            # blanks with content beyond them are byte-stable.
            if (found) {
                left_blank = 1
                for (i = 0; i < removed_at; i++) {
                    if (out[i] !~ /^[ \t]*$/) { left_blank = 0; break }
                }
                right_blank = 1
                for (i = removed_at; i < n; i++) {
                    if (out[i] !~ /^[ \t]*$/) { right_blank = 0; break }
                }
                if (left_blank && right_blank) {
                    n = 0
                } else if (right_blank) {
                    n = removed_at
                    while (n > 0 && out[n-1] ~ /^[ \t]*$/) n--
                } else if (left_blank) {
                    s = 0
                    while (s < n && out[s] ~ /^[ \t]*$/) s++
                    for (i = s; i < n; i++) print out[i]
                    exit
                } else if (out[removed_at-1] ~ /^[ \t]*$/ \
                        && out[removed_at] ~ /^[ \t]*$/) {
                    for (i = removed_at; i < n-1; i++) out[i] = out[i+1]
                    n--
                }
            }
            for (i = 0; i < n; i++) print out[i]
        }
    ' "$file" >"$out_tmp" || {
        [[ $? -eq 3 ]] && die "unterminated block \"# BEGIN $name\" in $file"
        die "failed to edit $file"
    }
}

# Build the result in a same-directory temp; the caller commits it
# atomically. Returns 1 when the marker is already present (no change).
zp_ensure_line() {
    local file="$1" marker="$2" line="$3" out_tmp="$4"
    if grep -qF -- "$marker" "$file"; then
        return 1
    fi
    {
        cat "$file"
        if [[ -s "$file" && -n "$(tail -c 1 "$file")" ]]; then
            printf '\n'
        fi
        printf '%s\n' "$line"
    } >"$out_tmp"
    return 0
}

zp_path_block_body() {
    local dir="$1" mode="$2"
    if [[ "$mode" == "append" ]]; then
        printf 'case ":${PATH}:" in\n    *":%s:"*) ;;\n    *) export PATH="${PATH}:%s" ;;\nesac\n' "$dir" "$dir"
    else
        printf 'case ":${PATH}:" in\n    *":%s:"*) ;;\n    *) export PATH="%s:${PATH}" ;;\nesac\n' "$dir" "$dir"
    fi
}

zp_lint_file() {
    local file="$1"
    awk -v file="$file" '
        BEGIN { open = ""; run = 0; findings = 0 }
        {
            if ($0 ~ /^# BEGIN /) {
                if (open != "") { printf "%s:%d: nested BEGIN inside an open block\n", file, NR; findings++ }
                else { open = $0 }
                if (seen[$0]) { printf "%s:%d: duplicate block: %s\n", file, NR, $0; findings++ }
                seen[$0] = 1
            } else if ($0 ~ /^# END /) {
                if (open == "") { printf "%s:%d: END without BEGIN\n", file, NR; findings++ }
                else if ($0 != "# END " substr(open, 9)) {
                    printf "%s:%d: %s does not close %s\n", file, NR, $0, open; findings++
                }
                open = ""
            } else if (open == "" && $0 ~ /^[ \t]*export[ \t]+PATH=/) {
                printf "%s:%d: unguarded PATH export: %s\n", file, NR, $0; findings++
            } else if (open == "" && $0 ~ /^[ \t]*path=\(/) {
                printf "%s:%d: unguarded path assignment: %s\n", file, NR, $0; findings++
            }
            if ($0 ~ /^[ \t]*$/) {
                run++
                if (run == 3) { printf "%s:%d: blank run (3+ consecutive lines)\n", file, NR - 2; findings++ }
            } else {
                run = 0
            }
        }
        END {
            if (open != "") { printf "%s: unterminated block at EOF\n", file; findings++ }
            if (run > 0) { printf "%s: trailing blank line(s) at EOF\n", file; findings++ }
            exit (findings > 0)
        }
    ' "$file"
}

zp_compact_file() {
    local file="$1" out_tmp="$2"
    awk '
        { buf[n++] = $0 }
        END {
            m = 0
            for (i = 0; i < n; i++) {
                if (buf[i] ~ /^[ \t]*$/ && m > 0 && out[m-1] ~ /^[ \t]*$/) continue
                out[m++] = buf[i]
            }
            while (m > 0 && out[m-1] ~ /^[ \t]*$/) m--
            s = 0
            while (s < m && out[s] ~ /^[ \t]*$/) s++
            for (i = s; i < m; i++) print out[i]
        }
    ' "$file" >"$out_tmp"
}

cmd="${1:-}"
case "$cmd" in
    ensure-block|remove-block|ensure-line|ensure-path-block|lint|compact|--help|-h|help|"") ;;
    *) die "unknown command: $cmd" ;;
esac
[[ -n "$cmd" ]] || { usage; exit 1; }
case "$cmd" in --help|-h|help) usage; exit 0 ;; esac
shift

case "$cmd" in
    ensure-block)
        file="" name="" absorb_tmp=""
        absorb_tmp="$(mktemp)"
        trap 'rm -f "$absorb_tmp"' EXIT
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --file) file="${2:?missing value for $1}"; shift 2 ;;
                --name) name="${2:?missing value for $1}"; shift 2 ;;
                --absorb-marker) [[ -n "${2:-}" ]] || die "--absorb-marker requires a value"; printf '%s\n' "$2" >>"$absorb_tmp"; shift 2 ;;
                *) die "ensure-block: unknown option: $1" ;;
            esac
        done
        zp_require_name "$name"
        zp_require_file "$file"
        body_tmp="$(mktemp)"
        out_tmp="$(zp_out_tmp "$file")"
        trap 'rm -f "$absorb_tmp" "$body_tmp" "$out_tmp"' EXIT
        cat >"$body_tmp"
        [[ -s "$body_tmp" ]] || die "empty block body on stdin"
        zp_ensure_block "$file" "$name" "$absorb_tmp" "$body_tmp" "$out_tmp"
        if zp_commit "$file" "$out_tmp"; then
            printf 'ensured block "%s" in %s\n' "$name" "$file"
        else
            printf 'unchanged block "%s" in %s\n' "$name" "$file"
        fi
        ;;

    remove-block)
        file="" name=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --file) file="${2:?missing value for $1}"; shift 2 ;;
                --name) name="${2:?missing value for $1}"; shift 2 ;;
                *) die "remove-block: unknown option: $1" ;;
            esac
        done
        [[ -n "$file" ]] || die "missing --file"
        zp_require_name "$name"
        [[ -f "$file" ]] || die "file not found: $file"
        out_tmp="$(zp_out_tmp "$file")"
        trap 'rm -f "$out_tmp"' EXIT
        zp_remove_block "$file" "$name" "$out_tmp"
        if zp_commit "$file" "$out_tmp"; then
            printf 'removed block "%s" from %s\n' "$name" "$file"
        else
            printf 'unchanged %s\n' "$file"
        fi
        ;;

    ensure-line)
        file="" marker="" line=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --file) file="${2:?missing value for $1}"; shift 2 ;;
                --marker) marker="${2:?missing value for $1}"; shift 2 ;;
                --line) line="${2:?missing value for $1}"; shift 2 ;;
                *) die "ensure-line: unknown option: $1" ;;
            esac
        done
        [[ -n "$marker" ]] || die "missing --marker"
        [[ -n "$line" ]] || die "missing --line"
        zp_require_file "$file"
        out_tmp="$(zp_out_tmp "$file")"
        trap 'rm -f "$out_tmp"' EXIT
        if zp_ensure_line "$file" "$marker" "$line" "$out_tmp" \
            && zp_commit "$file" "$out_tmp"; then
            printf 'ensured line in %s\n' "$file"
        else
            printf 'unchanged: marker already present in %s\n' "$file"
        fi
        ;;

    ensure-path-block)
        file="" name="" dir="" mode="prepend"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --file) file="${2:?missing value for $1}"; shift 2 ;;
                --name) name="${2:?missing value for $1}"; shift 2 ;;
                --dir) dir="${2:?missing value for $1}"; shift 2 ;;
                --append) mode="append"; shift ;;
                *) die "ensure-path-block: unknown option: $1" ;;
            esac
        done
        zp_require_name "$name"
        zp_require_file "$file"
        [[ -n "$dir" ]] || die "missing --dir"
        [[ "$dir" != *'"'* && "$dir" != *$'\n'* ]] || die "--dir cannot contain a quote or newline"
        body_tmp="$(mktemp)"
        out_tmp="$(zp_out_tmp "$file")"
        empty_absorb="$(mktemp)"
        trap 'rm -f "$body_tmp" "$out_tmp" "$empty_absorb"' EXIT
        zp_path_block_body "$dir" "$mode" >"$body_tmp"
        zp_ensure_block "$file" "$name" "$empty_absorb" "$body_tmp" "$out_tmp"
        if zp_commit "$file" "$out_tmp"; then
            printf 'ensured block "%s" in %s\n' "$name" "$file"
        else
            printf 'unchanged block "%s" in %s\n' "$name" "$file"
        fi
        ;;

    lint)
        [[ $# -gt 0 ]] || die "lint requires at least one file"
        status=0
        for f in "$@"; do
            [[ -f "$f" ]] || { printf '%s: file not found: %s\n' "$PROG" "$f" >&2; status=1; continue; }
            zp_lint_file "$f" || status=1
        done
        exit "$status"
        ;;

    compact)
        [[ $# -gt 0 ]] || die "compact requires at least one file"
        for f in "$@"; do
            [[ -f "$f" ]] || die "file not found: $f"
            out_tmp="$(zp_out_tmp "$f")"
            zp_compact_file "$f" "$out_tmp"
            if zp_commit "$f" "$out_tmp"; then
                printf 'compacted %s\n' "$f"
            else
                printf 'unchanged %s\n' "$f"
            fi
            rm -f "$out_tmp"
        done
        ;;
esac
